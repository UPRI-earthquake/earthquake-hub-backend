// Earthquake Hub: the PostgreSQL schema, as the migrations (src/db/migrations) build it.
// Generated by scripts/schema-to-dbml.js: regenerate it after a migration, don't edit it by hand.
// Paste into https://dbdiagram.io to see the diagram. Docs: DB_SCHEMA.md

Project earthquake_hub {
  database_type: 'PostgreSQL'
}

Enum account_role {
  citizen
  sensor
  brgy
  admin
}

Enum catalog_source {
  phivolcs
  usgs
  "upri-legacy"
}

Enum comment_status {
  pending
  approved
  rejected
}

Enum contribution_action {
  report_posted
  image_report_posted
  report_marked_helpful
  report_received_helpful
  report_issue_submitted
}

Enum contribution_target {
  comment
  event
}

Enum device_activity {
  active
  inactive
  unlinked
}

Enum enrichment_status {
  pending
  done
  no_match
  failed
}

Enum issue_reason {
  duplicate
  unclear
  wrong_location
  not_related
  inappropriate
}

Enum match_quality {
  high
  medium
  low
}

Enum recording_status {
  pending
  partial
  verified
  unavailable
}

Enum station_kind {
  candidate
  recording
}

Table accounts {
  id uuid [pk, default: `uuidv7()`]
  legacy_mongo_id "character(24)" [unique, note: '_id of the MongoDB document this row was copied from']
  email citext [not null, unique, note: 'compared case-insensitively']
  username citext [not null, unique, note: 'compared case-insensitively']
  password_hash text [not null, note: 'bcrypt; never returned by the API']
  roles "account_role[]" [not null, default: `'{}'::account_role[]`]
  is_approved boolean [not null, default: `false`, note: 'brgy accounts need admin approval']
  password_policy_version integer [not null, default: `1`]
  password_updated_at "timestamp with time zone"
  password_reset_token_id text [note: 'SHA-256 of the reset token id; single use']
  password_reset_issued_at "timestamp with time zone"
  password_reset_used_at "timestamp with time zone"
  ringserver_url text [unique, note: 'brgy accounts only']
  ringserver_port integer
  rshake_email_enabled boolean [not null, default: `false`, note: 'device alert emails']
  alert_prefs_updated_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  updated_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]

  Note: '''
    One user: a citizen (who may own sensors), a barangay, or an admin
    Checks:
    accounts_email_not_blank: CHECK ((btrim((email)::text) <> ''::text))
    accounts_ringserver_port_range: CHECK (((ringserver_port >= 1) AND (ringserver_port <= 65535)))
    accounts_username_not_blank: CHECK ((btrim((username)::text) <> ''::text))
  '''
}

Table brgy_forwarded_devices {
  brgy_account_id uuid [not null]
  device_id uuid [not null]
  added_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`, note: 'orders a brgy\'s list, oldest first']

  indexes {
    (brgy_account_id, device_id) [pk]
    device_id [name: 'brgy_forwarded_devices_device_id_index', type: btree]
  }

  Note: '''
    A sensor whose data a barangay ringserver forwards (the sensor belongs to another account)
  '''
}

Table comment_helpful_marks {
  comment_id uuid [not null]
  account_id uuid [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`, note: 'copied marks: the report\'s updated_at (MongoDB kept no time per mark)']

  indexes {
    (comment_id, account_id) [pk]
    account_id [name: 'comment_helpful_marks_account_id_index', type: btree]
  }

  Note: '''
    An account marking a report helpful: at most once per report
  '''
}

Table comment_issue_reports {
  comment_id uuid [not null]
  account_id uuid [not null]
  reason issue_reason [not null]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`, note: 'when the account last flagged it']

  indexes {
    (comment_id, account_id) [pk]
    account_id [name: 'comment_issue_reports_account_id_index', type: btree]
  }

  Note: '''
    An account flagging a report for moderators: at most one flag per account per report
  '''
}

Table comments {
  id uuid [pk, default: `uuidv7()`]
  legacy_mongo_id "character(24)" [unique, note: '_id of the MongoDB document this row was copied from']
  comment_id uuid [not null, unique, default: `gen_random_uuid()`, note: 'public id used in URLs (API: commentId)']
  event_id uuid [not null]
  account_id uuid [note: 'who posted it; null = signed out, or the account was deleted']
  username text [not null, default: `'Anonymous'::text`, note: 'name shown: the username, or Anonymous']
  content "character varying(1000)" [note: 'the report text']
  image_url text [note: 'path of the uploaded image (API: imageURL)']
  status comment_status [not null, default: `'approved'::comment_status`, note: 'moderation: only approved reports are shown']
  moderated_by text [note: 'admin who set the status']
  moderated_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  updated_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    account_id [name: 'comments_account_id_index', type: btree]
    (event_id, status, created_at, comment_id) [name: 'comments_event_id_status_created_at_comment_id_index', type: btree]
  }

  Note: '''
    A community report on an earthquake: text and/or an image
    Checks:
    comments_has_content_or_image: CHECK ((((content IS NOT NULL) AND (btrim((content)::text) <> ''::text)) OR ((image_url IS NOT NULL) AND (btrim(image_url) <> ''::text))))
    comments_username_not_blank: CHECK ((btrim(username) <> ''::text))
  '''
}

Table contribution_events {
  id uuid [pk, default: `uuidv7()`]
  legacy_mongo_id "character(24)" [unique, note: '_id of the MongoDB document this row was copied from']
  dedupe_key text [not null, unique, note: 'account:action:target type:target id; an action never counts twice (API: dedupeKey)']
  account_id uuid [not null]
  action_type contribution_action [not null]
  target_type contribution_target [not null, default: `'comment'::contribution_target`]
  target_id text [note: 'the comment\'s public id (comments.comment_id), or the event\'s']
  event_id uuid
  points integer [not null, default: `0`]
  reason text [note: 'issue reason, for report_issue_submitted']
  metadata jsonb [not null, default: `'{}'::jsonb`]
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (account_id, created_at) [name: 'contribution_events_account_id_created_at_index', type: btree]
    (event_id, created_at) [name: 'contribution_events_event_id_created_at_index', type: btree]
  }

  Note: '''
    Points ledger: one row per action that earns (or records) points
    Checks:
    contribution_events_dedupe_key_not_blank: CHECK ((btrim(dedupe_key) <> ''::text))
    contribution_events_metadata_is_object: CHECK ((jsonb_typeof(metadata) = 'object'::text))
  '''
}

Table device_releases {
  id uuid [pk, default: `uuidv7()`]
  legacy_mongo_id "character(24)" [unique, note: '_id of the releasedDevices[] entry this row was copied from']
  account_id uuid [not null, note: 'who released it; their history goes with the account']
  device_id uuid [note: 'null if the device was later deleted']
  network "character varying(8)"
  station "character varying(16)"
  stream_id text
  mac_address text
  description text
  latitude "double precision"
  longitude "double precision"
  elevation_m "double precision"
  reason text [not null, default: `'unlink'::text`]
  released_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  device_legacy_mongo_id "character(24)" [note: 'MongoDB-style id of the released device (API: deviceId); kept after the device is deleted']

  indexes {
    (account_id, released_at) [name: 'device_releases_account_id_released_at_index', type: btree]
  }

  Note: '''
    A device an account unlinked, as the device was at that moment
  '''
}

Table devices {
  id uuid [pk, default: `uuidv7()`]
  legacy_mongo_id "character(24)" [unique, note: '_id of the MongoDB document this row was copied from']
  owner_account_id uuid [note: 'null = no owner (unlinked); replaces accounts.devices[]']
  network "character varying(8)" [not null, note: 'e.g. AM']
  station "character varying(16)" [not null, note: 'e.g. R3B2D']
  description text
  stream_id text [unique, note: 'null = not linked yet']
  mac_address text [unique, note: 'null = not linked yet']
  latitude "double precision" [not null]
  longitude "double precision" [not null]
  elevation_m "double precision" [not null, note: 'API: elevation']
  activity device_activity [not null, default: `'inactive'::device_activity`]
  activity_toggled_at "timestamp with time zone" [not null, default: `'1970-01-01 00:00:00+00'::timestamp with time zone`, note: 'API: activityToggleTime']
  rshake_alert_credential_hash text [note: 'never returned by the API']
  rshake_alert_credential_issued_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  updated_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  location "geography(Point,4326)" [note: 'generated: (st_setsrid(st_makepoint(longitude, latitude), 4326))::geography']

  indexes {
    (network, station) [unique, name: 'devices_network_station_unique']
    activity [name: 'devices_activity_index', type: btree]
    location [name: 'devices_location_idx', note: 'gist index']
    owner_account_id [name: 'devices_owner_account_id_index', type: btree]
  }

  Note: '''
    One Raspberry Shake sensor
    Checks:
    devices_latitude_range: CHECK (((latitude >= ('-90'::integer)::double precision) AND (latitude <= (90)::double precision)))
    devices_longitude_range: CHECK (((longitude >= ('-180'::integer)::double precision) AND (longitude <= (180)::double precision)))
    devices_mac_address_not_empty: CHECK ((mac_address <> ''::text))
    devices_network_station_not_blank: CHECK (((btrim((network)::text) <> ''::text) AND (btrim((station)::text) <> ''::text)))
    devices_stream_id_not_empty: CHECK ((stream_id <> ''::text))
  '''
}

Table event_catalog_matches {
  id uuid [pk, default: `uuidv7()`]
  event_id uuid [not null]
  source catalog_source [not null]
  source_label text [note: 'API: sourceLabel']
  source_icon_url text [note: 'API: sourceIconUrl']
  external_id text [note: 'id in that catalog (API: id)']
  title text
  place text
  location_text text [note: 'API: location']
  detail text
  url text
  detail_url text [note: 'API: detailUrl']
  query_url text [note: 'API: queryUrl']
  match_time "timestamp with time zone" [note: 'API: time']
  match_time_text text [note: 'PHIVOLCS date text, GMT+8 (API: dateTime)']
  latitude "double precision"
  longitude "double precision"
  depth_km "double precision" [note: 'API: depthKm (PHIVOLCS, legacy) or depth (USGS)']
  magnitude "double precision"
  has_felt_intensity boolean [note: 'API: hasFeltIntensity']
  distance_km "double precision" [note: 'API: distanceKm']
  time_difference_minutes "double precision" [note: 'API: timeDifferenceMinutes']
  magnitude_difference "double precision" [note: 'API: magnitudeDifference']
  latitude_floor_match boolean [note: 'API: latitudeFloorMatch']
  longitude_floor_match boolean [note: 'API: longitudeFloorMatch']
  score "double precision" [note: 'lower is a better match']
  match_quality match_quality [note: 'API: matchQuality']
  extra jsonb [not null, default: `'{}'::jsonb`, note: 'upstream keys without a column']
  raw jsonb [note: 'full upstream payload']
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  updated_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  position smallint [not null, default: `'0'::smallint`, note: 'order among the event\'s matches (API: additionalInformation[] order)']

  indexes {
    (event_id, source) [unique, name: 'event_catalog_matches_event_id_source_unique']
  }

  Note: '''
    The matching report another catalog (PHIVOLCS, USGS, old UPRI) has for an earthquake
    Checks:
    event_catalog_matches_extra_is_object: CHECK ((jsonb_typeof(extra) = 'object'::text))
  '''
}

Table event_catalog_status {
  event_id uuid [not null]
  source catalog_source [not null]
  status enrichment_status [not null, default: `'pending'::enrichment_status`]
  attempts integer [not null, default: `0`]
  updated_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (event_id, source) [pk]
    (source, status) [name: 'event_catalog_status_source_status_index', type: btree]
  }

  Note: '''
    How far the nightly enrichment job got for one earthquake in one catalog
    Checks:
    event_catalog_status_attempts_not_negative: CHECK ((attempts >= 0))
    event_catalog_status_searched_source: CHECK ((source = ANY (ARRAY['phivolcs'::catalog_source, 'usgs'::catalog_source])))
  '''
}

Table event_stations {
  event_id uuid [not null]
  device_id uuid [not null, note: 'the station']
  kind station_kind [not null, note: 'candidate: nearest active station at ingest; recording: FDSN has its waveform data']
  position smallint [not null, note: 'order in the list, nearest first']

  indexes {
    (event_id, device_id, kind) [pk]
    (event_id, kind, position) [unique, name: 'event_stations_event_id_kind_position_unique']
    device_id [name: 'event_stations_device_id_index', type: btree]
  }

  Note: '''
    A station (device) near an earthquake: a candidate at ingest, or one confirmed to have recorded it
    Checks:
    event_stations_position_not_negative: CHECK (("position" >= 0))
  '''
}

Table events {
  id uuid [pk, default: `uuidv7()`]
  legacy_mongo_id "character(24)" [unique, note: '_id of the MongoDB document this row was copied from']
  public_id text [not null, unique, note: 'SeisComP event id (API: publicID)']
  source_catalog text [not null, default: `'upri-current'::text`, note: 'API: sourceCatalog']
  source_server text [note: 'API: sourceServer']
  source_seiscomp_version text [note: 'API: sourceSeiscompVersion']
  is_legacy_record boolean [not null, default: `false`, note: 'imported from the old catalog (API: isLegacyRecord)']
  legacy_imported_at "timestamp with time zone" [note: 'API: legacyImportedAt']
  legacy_source_public_id text [note: 'API: legacySourcePublicID']
  origin_time "timestamp with time zone" [note: 'API: OT']
  latitude "double precision" [note: 'API: latitude_value']
  longitude "double precision" [note: 'API: longitude_value']
  depth_km "double precision" [note: 'API: depth_value']
  magnitude "double precision" [note: 'API: magnitude_value']
  seiscomp_type "character varying(10)" [note: 'latest SeisComP message type, e.g. NEW, UPDATE (API: type)']
  region_text text [note: 'SeisComP region text (API: text)']
  place text [note: 'GeoServe place name, filled on first read']
  recording_status recording_status [not null, default: `'pending'::recording_status`, note: 'which nearby stations recorded it (API: recordingAvailabilityStatus)']
  recording_checked_at "timestamp with time zone" [note: 'API: recordingAvailabilityCheckedAt']
  recording_attempts integer [not null, default: `0`, note: 'API: recordingAvailabilityAttempts']
  last_modification "timestamp with time zone" [note: 'drops SeisComP updates that arrive out of order']
  summary_override_text text [note: 'summary edited by hand (API: summaryOverride.text)']
  summary_override_edited_at "timestamp with time zone"
  summary_override_edited_by text
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  updated_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  location "geography(Point,4326)" [note: 'generated: 
CASE
    WHEN ((latitude >= (\'-90\'::integer)::double precision) AND (latitude <= (90)::double precision) AND ((longitude >= (\'-180\'::integer)::double precision) AND (longitude <= (180)::double precision))) THEN (st_setsrid(st_makepoint(longitude, latitude), 4326))::geography
    ELSE NULL::geography
END']

  indexes {
    is_legacy_record [name: 'events_is_legacy_record_index', type: btree]
    location [name: 'events_location_idx', note: 'gist index']
    origin_time [name: 'events_origin_time_index', type: btree]
    recording_status [name: 'events_recording_status_index', type: btree]
    source_catalog [name: 'events_source_catalog_index', type: btree]
  }

  Note: '''
    One earthquake detected by SeisComP
    Checks:
    events_public_id_not_blank: CHECK ((btrim(public_id) <> ''::text))
    events_recording_attempts_not_negative: CHECK ((recording_attempts >= 0))
    events_summary_override_has_text: CHECK (((summary_override_text IS NOT NULL) OR ((summary_override_edited_at IS NULL) AND (summary_override_edited_by IS NULL))))
  '''
}

Table job_locks {
  name text [pk, note: 'e.g. additional-information-enrichment']
  owner text [not null, note: 'hostname:pid of the process holding the lock']
  expires_at "timestamp with time zone" [not null]
  updated_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    expires_at [name: 'job_locks_expires_at_index', type: btree]
  }

  Note: '''
    Mutex for background jobs, so only one backend instance runs a job at a time
  '''
}

Table significant_eq_details {
  id uuid [pk, default: `uuidv7()`]
  legacy_mongo_id "character(24)" [unique, note: '_id of the MongoDB significant-eqs entry this row was copied from']
  event_id uuid [not null, unique]
  instrument_recordings "text[]" [not null, default: `'{}'::text[]`, note: 'station codes whose recordings the page shows (API: instrumentRecordings)']
  reference_urls "text[]" [not null, default: `'{}'::text[]`, note: 'links to reports about the earthquake (API: references)']
  edited_by text [note: 'admin who last set them']
  edited_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]
  updated_at "timestamp with time zone" [not null, default: `CURRENT_TIMESTAMP`]

  Note: '''
    Hand-added details for an earthquake on the significant earthquakes page
  '''
}

