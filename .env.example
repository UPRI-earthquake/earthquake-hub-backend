# Push notifications keys. You can generate them with command "./node_modules/.bin/web-push generate-vapid-keys"
PUBLIC_VAPID_KEY=paste_key_here
PRIVATE_VAPID_KEY=paste_key_here  
# This must be either a URL or a 'mailto:' address.
# For example: 'https://my-site.com/contact' or 'mailto: contact@my-site.com'
WEB_PUSH_CONTACT=mailto: contact@my-site.com
NOTIF_CLEANUP_ENABLED=true
NOTIF_CLEANUP_INTERVAL_MIN=60
NOTIF_STALE_DAYS=90
NOTIF_FAILURE_THRESHOLD=3
NOTIF_INVALID_TTL_DAYS=7

# notifications DB
# service network name via docker-compose
MONGO_CONNX_TYPE=docker
MONGO_HOST=mongodb 
MONGO_PORT=27017
MONGO_NAME=latestEQs

# Admin audit retention. Successful routine telemetry reads expire sooner than
# failed telemetry and privileged administrative lifecycle events. Set either
# value to 0 only when new records in that class must be retained indefinitely.
ADMIN_AUDIT_TELEMETRY_RETENTION_DAYS=90
ADMIN_AUDIT_ADMINISTRATIVE_RETENTION_DAYS=730
# Active incidents never expire. Keep event retention at least as long as
# resolved-incident retention so lifecycle evidence remains available.
ADMIN_INCIDENT_RESOLVED_RETENTION_DAYS=730
ADMIN_INCIDENT_EVENT_RETENTION_DAYS=730
# Append-only station activity and WSTunnel registry transitions. History starts
# when this feature is deployed; it does not reconstruct earlier transitions.
ADMIN_STATION_HISTORY_RETENTION_DAYS=365
# Ringserver packet-freshness samples are separate from transition history.
# Defaults retain one sample per station every 15 minutes for 90 days.
ADMIN_STATION_TELEMETRY_SAMPLE_INTERVAL_SECONDS=900
ADMIN_STATION_TELEMETRY_RETENTION_DAYS=90

# Server-authoritative Admin Console mutation switches. Existing supported
# workflows default to enabled when omitted. Set a switch to false to disable
# both its API mutation and its frontend controls without rebuilding images.
ADMIN_ACCOUNT_APPROVAL_ENABLED=true
ADMIN_ACCOUNT_LIFECYCLE_ENABLED=true
ADMIN_ACCOUNT_SESSION_REVOCATION_ENABLED=true
ADMIN_ACCOUNT_ROLE_MANAGEMENT_ENABLED=true
ADMIN_INCIDENT_MANAGEMENT_ENABLED=true
ADMIN_RECENT_AUTH_MAX_AGE_SECONDS=900
ADMIN_REPORT_MODERATION_ENABLED=true
ADMIN_REPORT_DELETION_ENABLED=true
ADMIN_EVENT_SUMMARY_ENABLED=true
ADMIN_EVENT_SUMMARY_REVIEW_ENABLED=true
# Temporary rollout escape hatch. When true, Draft and Needs Review custom
# summaries retain their legacy public behavior. Keep false for the Approved-only
# contract; enable only while legacy summaries are being reviewed.
EVENT_SUMMARY_ALLOW_UNAPPROVED_COMPAT=false
ADMIN_EVENT_ENRICHMENT_ENABLED=true
ADMIN_EVENT_RECORDING_REFRESH_ENABLED=true
ADMIN_DEVICE_REMOTE_ACTIONS_ENABLED=true
ADMIN_TUNNEL_REVOCATION_ENABLED=true

# .env file for cloud mongo connection
# MONGO_HOST=username:password@server-cluster-name
# MONGO_NAME=test

# Granular reverse-geolocation
GEOSERVE_HOST=geoserve-ws
GEOSERVE_PORT=80

# Online-station FDSN checks
FDSNWS_DATASELECT_URL=https://earthquake.up.edu.ph/fdsnws/dataselect/1/query
FDSNWS_NETWORK=AM
FDSNWS_LOCATION=00
FDSNWS_CHANNEL=EHZ
FDSNWS_WINDOW_SECONDS=30
ONLINE_STATION_REFINEMENT_DELAY_MS=0

# Earthquake catalog enrichment scheduler
# ENRICHMENT_CRON uses node-cron syntax. Default: daily at 02:00 in TZ.
TZ=Asia/Manila
ENRICHMENT_CRON=0 2 * * *
ENRICHMENT_MIN_AGE_HOURS=12
MAX_ENRICHMENT_ATTEMPTS=3
ENRICHMENT_BATCH_SIZE=25
ENRICHMENT_RUN_ON_STARTUP=false
ENRICHMENT_STARTUP_DELAY_MS=30000
ENRICHMENT_LOCK_TTL_MS=3600000
USGS_REQUEST_TIMEOUT_MS=15000
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# production host domains
CLIENT_PROD_HOST=10.207.9.43
BACKEND_PROD_HOST=10.207.9.43/api
BACKEND_PROD_PORT=5000
W3_CLIENT_PROD_HOST=rs.local:3000

# development host domains
CLIENT_DEV_HOST=localhost
CLIENT_DEV_PORT=3000
BACKEND_DEV_HOST=backend
BACKEND_DEV_PORT=5000
W3_CLIENT_DEV_HOST=localhost

# Report image uploads
# - UPLOAD_DIR controls the real filesystem directory used by the backend for uploaded report images.
# - In local development, you can leave UPLOAD_DIR unset and the backend will fall back to ./public/uploads_dev.
# - In production, UPLOAD_DIR is required and should point to a persistent server directory or mounted volume.
# - UPLOAD_PUBLIC_PATH controls the browser-facing URL prefix for uploaded files.
# - Existing legacy /uploads_dev/... URLs remain readable for backward compatibility, but new uploads should use /uploads.
# Development example:
# UPLOAD_DIR=./public/uploads_dev
# Production example:
# UPLOAD_DIR=/srv/earthquake-hub/uploads
UPLOAD_PUBLIC_PATH=/uploads

#ringserver host
RINGSERVER_HOST=host.docker.internal
RINGSERVER_PORT=16000

# Admin operational snapshots
# Evidence older than this threshold is labeled stale even if its source
# remains reachable. Keep this longer than the host telemetry polling/check
# duration and shorter than the operator refresh expectation.
ADMIN_TELEMETRY_STALE_AFTER_MS=60000
ADMIN_OVERVIEW_CACHE_TTL_MS=5000
ADMIN_OVERVIEW_SOURCE_TIMEOUT_MS=2500

# jsonwebtoken
# generate token via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))" and paste the output here
# Web app session cookies (HTTP-only)
ACCESS_TOKEN_PRIVATE_KEY_WEB=some_secret_key_for_web
REFRESH_TOKEN_PRIVATE_KEY_WEB=some_refresh_secret_key_for_web
JWT_WEB_EXPIRY='12h'                 # access token lifetime for web cookies
REFRESH_TOKEN_WEB_EXPIRY='30 days'   # refresh token lifetime for web cookies

# Account identifiers & username policy
# Sign-in accepts username or contact email; adjust these only if all services share the same rules.
USERNAME_MIN_LENGTH=3
USERNAME_MAX_LENGTH=32
USERNAME_ALLOWED_PATTERN=^[a-zA-Z0-9._-]+$

# Device / non-cookie tokens (ringserver, sensors, barangays)
# - ACCESS_TOKEN_PRIVATE_KEY_DEVICE: signs/verifies sensor/sender access JWTs (Authorization: Bearer <token>).
# - ACCESS_TOKEN_PRIVATE_KEY_BRGY: signs/verifies barangay access JWTs (RingServer bearer, etc.).
# - REFRESH_TOKEN_PRIVATE_KEY: signs/verifies sensor/sender refresh JWTs.
# - REFRESH_TOKEN_PRIVATE_KEY_BRGY: signs/verifies barangay refresh JWTs.
# - REFRESH_TOKEN_EXPIRY: default lifetime for device refresh JWTs (if `REFRESH_TOKEN_DEVICE_EXPIRY` is unset).
# - REFRESH_TOKEN_BRGY_EXPIRY: optional barangay refresh JWT lifetime (defaults to 365d).
# - JWT_DEVICE_EXPIRY / JWT_BRGY_EXPIRY: optional access token lifetimes (defaults: device 12h, brgy 365d).
# - REFRESH_TOKEN_DEVICE_EXPIRY: optional device refresh token lifetime (defaults to REFRESH_TOKEN_EXPIRY).
ACCESS_TOKEN_PRIVATE_KEY_DEVICE=some_secret_key_for_devices
ACCESS_TOKEN_PRIVATE_KEY_BRGY=some_secret_key_for_brgys
REFRESH_TOKEN_PRIVATE_KEY=some_refresh_secret_key_for_devices
REFRESH_TOKEN_PRIVATE_KEY_BRGY=some_refresh_secret_key_for_brgys
REFRESH_TOKEN_EXPIRY='90 days'
REFRESH_TOKEN_DEVICE_EXPIRY='90 days'
REFRESH_TOKEN_BRGY_EXPIRY='365d'
JWT_DEVICE_EXPIRY='30d'
JWT_BRGY_EXPIRY='365d'
# During rollout, set ACCESS_TOKEN_PRIVATE_KEY_DEVICE equal to your legacy ACCESS_TOKEN_PRIVATE_KEY to avoid invalidating existing sender tokens. When you later rotate to a new device key, existing sender tokens will fail verification and devices must re-authenticate to obtain fresh tokens.

# Legacy fallbacks (used if the scoped keys above are not set)
ACCESS_TOKEN_PRIVATE_KEY=legacy_fallback_secret
JWT_EXPIRY='12h'

# Password reset tokens (single use)
PASSWORD_RESET_TOKEN_KEY=some_password_reset_secret
PASSWORD_RESET_TOKEN_EXPIRY='30m'

# Email sender (Nodemailer SMTP; defaults work with MailHog/Mailpit on localhost:1025)
# Local SMTP test (choose one):
# - MailHog:  docker run --rm -p 1025:1025 -p 8025:8025 mailhog/mailhog      (UI: http://localhost:8025)
# - Mailpit:  docker run --rm -p 1025:1025 -p 8025:8025 axllent/mailpit     (UI: http://localhost:8025)
# Keep the defaults below for MailHog/Mailpit (host localhost, port 1025, no auth).
# Gmail / SMTP provider:
# - Turn on 2FA, create an App Password (choose “Mail”, “Other”, etc.).
# - Use SMTP host/port from your provider (Gmail: host smtp.gmail.com, port 587, secure=false for STARTTLS; port 465 secure=true).
# - Set EMAIL_USER to the mailbox, EMAIL_PASS to the App Password (never your normal login).
EMAIL_TRANSPORT=smtp
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="UPRI Earthquake Hub <no-reply@upri.edu.ph>"
# Optional branding logo for HTML emails:
# - EMAIL_LOGO_URL: publicly reachable logo URL (preferred in production).
# - EMAIL_LOGO_PATH: local file path fallback if URL is not set.
# - EMAIL_LOGO_PUBLIC_FILE: filename inside earthquake-hub-frontend/public (e.g. badge-92x92.png).
# - EMAIL_FRONTEND_PUBLIC_DIR: optional override for the frontend public directory root.
#   Set this when backend runs from a different working directory/repo.
#   Example: ../earthquake-hub-web-client/earthquake-hub-frontend/public
# - If both are empty, backend falls back to the monorepo frontend logo asset when available.
# EMAIL_LOGO_URL=https://example.org/assets/upri-logo.png
# EMAIL_LOGO_PATH=../earthquake-hub-frontend/public/badge-92x92.png
# EMAIL_LOGO_PUBLIC_FILE=badge-92x92.png
# EMAIL_FRONTEND_PUBLIC_DIR=../earthquake-hub-frontend/public
# Sender-alert email routing:
# - Users receive sender alert emails only if they enable it in Dashboard > Tools (off by default).
# - Admin monitoring recipients are always included for sender alerts.
# - ALERT_EMAIL_ADMIN_TO accepts comma/semicolon-separated emails.
# - If ALERT_EMAIL_ADMIN_TO is empty, backend falls back to EMAIL_FROM address.
# - ALERT_EMAIL_THREAD_* keeps admin monitoring emails grouped in one thread.
# - RSHAKE_ALERT_SHARED_SECRET (optional) enforces a static global
#   `X-RShake-Alert-Secret` on POST /messaging/restricted/rshake-alert.
# - Sender devices can also receive device-scoped alert credentials automatically
#   after linking, so this global secret is an optional override.
# - Keep empty to require auto-issued per-device credentials instead of a shared secret.
ALERT_EMAIL_ADMIN_TO=earthquake@science.upd.edu.ph
ALERT_EMAIL_THREAD_KEY=rshake-alerts
ALERT_EMAIL_THREAD_DOMAIN=earthquake-hub.local
# RSHAKE_ALERT_SHARED_SECRET=replace_with_long_random_secret
# Production SMTP port + TLS mode:
# - EMAIL_PORT=587 with EMAIL_SECURE=false uses STARTTLS (connect plain, then upgrade to TLS). Common for Gmail and many providers.
# - EMAIL_PORT=465 with EMAIL_SECURE=true uses implicit TLS/SMTPS (TLS from the first byte).
# Match your provider’s documentation; using the wrong pairing often causes TLS handshake/auth failures.

# Reverse SSH tunnel enrollment (server-side bastion registry)
# Backend calls these server-owned scripts to create/revoke mappings.
TUNNEL_REGISTER_SCRIPT=/opt/upri/bastion/register-device.sh
TUNNEL_REVOKE_SCRIPT=/opt/upri/bastion/revoke-device.sh
TUNNEL_RESOLVE_SCRIPT=/opt/upri/bastion/resolve-device.sh
TUNNEL_REGISTRY_FILE=/etc/upri/rshake-tunnels/devices.csv
TUNNEL_BASTION_HOST=ops.example.org
TUNNEL_BASTION_PORT=443
TUNNEL_PORT_RANGE_START=22000
TUNNEL_PORT_RANGE_END=22999
# Optional known_hosts pinning line returned to sender enrollment clients.
# Example: ops.example.org ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...
# TUNNEL_BASTION_HOST_KEY=
# Optional sender-side forced-command SSH key installed during tunnel enrollment.
# Format: full OpenSSH public key string (ssh-ed25519 ...).
# TUNNEL_REMOTE_ACTIONS_OPERATOR_PUBLIC_KEY=

# Optional remote action execution tuning (defaults reuse tunnel SSH settings where applicable).
# TUNNEL_REMOTE_ACTION_TIMEOUT_MS=20000
# TUNNEL_REMOTE_ACTION_SSH_HOST=host.docker.internal
# TUNNEL_REMOTE_ACTION_SSH_USER=myshake
# TUNNEL_REMOTE_ACTION_SSH_KEY_PATH=/opt/upri/bastion/ssh/tunnel-admin_id_ed25519
# TUNNEL_REMOTE_ACTION_SSH_STRICT_HOST_KEY=false

# Persistent allowlisted admin jobs.
# Completed job metadata expires after this many days; 0 keeps it indefinitely.
ADMIN_JOB_RETENTION_DAYS=180
# Execution deadline per attempt (milliseconds). Handlers stop cooperatively
# between bounded work items; the enrichment worker also retains its DB lock.
ADMIN_JOB_TIMEOUT_MS=3600000
# Maximum total attempts, including the original run.
ADMIN_JOB_MAX_ATTEMPTS=3
# Maximum recent attention events checked by one recording-verification job.
# The fixed FDSNWS endpoint and channel/network settings remain server-owned.
RECORDING_AVAILABILITY_JOB_BATCH_SIZE=100
